# WordPress headless CMS (content source for the landing page)
WORDPRESS_URL=https://your-wordpress-domain.com/wp-json/wp/v2
WORDPRESS_HOSTNAME=your-wordpress-domain.com

# WordPress content push (npm run wp:push) — writes ACF values via REST.
# Create an Application Password: WP Admin -> Users -> Profile -> Application Passwords.
WP_USERNAME=your-wp-login
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# On-demand revalidation — shared secret guarding /api/revalidate.
# WordPress calls /api/revalidate?secret=... on save so prod updates within seconds.
REVALIDATE_SECRET=generate-a-long-random-string

# Gmail Configuration for Nodemailer
# To use Gmail, you need to create an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords (under "Signing in to Google")
# 4. Generate a new app password for "Mail"
# 5. Copy the 16-character password below

GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: Email address to receive contact form submissions
# If not set, emails will be sent to GMAIL_USER
CONTACT_EMAIL=contact@yourdomain.com
